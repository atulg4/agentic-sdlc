{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "headSha",
    "verdict",
    "summary",
    "findings",
    "residualRisks",
    "acceptanceCriteriaVerdict"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "role": {"type": "string", "pattern": "^[a-z][a-z-]{1,63}$"},
    "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"type": "string", "enum": ["approve", "changes_requested"]},
    "summary": {"type": "string", "maxLength": 4000},
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "body",
          "file",
          "line",
          "blocking",
          "gateOutcome",
          "repairRecommendation"
        ],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "title": {"type": "string", "maxLength": 300},
          "body": {"type": "string", "maxLength": 4000},
          "file": {"type": "string", "maxLength": 1000},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "blocking": {"type": "boolean"},
          "gateOutcome": {"type": "string", "enum": ["block", "advise"]},
          "repairRecommendation": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "residualRisks": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 1000}
    },
    "acceptanceCriteriaVerdict": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "verdict"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1, "maxLength": 1000},
          "verdict": {"type": "string", "enum": ["met", "not_met", "not_verifiable"]}
        }
      }
    }
  }
}
